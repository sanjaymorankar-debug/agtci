# Copy to .env.test (gitignored) to run the database tests against real MySQL:
#
#   cp .env.test.example .env.test
#   npm run test:db
#
# Without this file, `npm test` still runs: the environment-validation tests
# need nothing, and the schema tests skip themselves with a reason. This file
# is what turns the schema tests on.
#
# Deliberately TEST_DATABASE_URL and not DATABASE_URL: the schema tests DROP
# every table in the target database before each case, so they must not be able
# to pick up a development database from a .env by accident. Setting
# DATABASE_URL does nothing here.

# Must be a THROWAWAY database -- every table in it is dropped and rebuilt from
# drizzle/. The default matches the local devstack (`devstack up`), which serves
# MySQL on 127.0.0.1:3307.
TEST_DATABASE_URL="mysql://kesari:devstack-local-only@127.0.0.1:3307/agtci_test"
