# Copy to .env.local for local development (or set these in your host's panel).
# src/lib/env.ts validates them once at startup and refuses to run without the
# two required ones, so a missing value fails immediately rather than surfacing
# later as a connection error mid-request.

# Required. The app will not start without it.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/agtci_dev"

# Required. Generate a real one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-value"

# Optional. Set in deployed environments where the canonical URL is not inferable.
AUTH_URL="http://localhost:3000"

# Optional. Digits only with country code, for wa.me click-to-chat links.
WHATSAPP_NUMBER="919175193009"
