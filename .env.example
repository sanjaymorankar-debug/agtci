# Copy to .env (or .env.local) and fill in. Validated at startup by src/lib/env.ts.
# A tier's server .env holds only that tier's URLs (see README, "Neon").

# PostgreSQL 13+ (gen_random_uuid() is used for IDs).
# On Neon: DATABASE_URL is the pooled connection string (host has -pooler),
# DATABASE_URL_UNPOOLED the direct one, used by migrations and drizzle-kit.
# Both end in ?sslmode=require&channel_binding=require. Locally only
# DATABASE_URL is needed: migrations fall back to it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agtci
# DATABASE_URL=postgresql://agtci_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/agtci?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://agtci_app:<password>@<endpoint>.<region>.aws.neon.tech/agtci?sslmode=require&channel_binding=require

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public base URL of the site, e.g. https://agtci.com (optional locally)
AUTH_URL=

# WhatsApp click-to-chat number, digits only with country code (e.g. 91XXXXXXXXXX)
WHATSAPP_NUMBER=
