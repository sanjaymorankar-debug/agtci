# agtci.com — one file per environment (.env for local; the hosting panel's
# environment variables for staging and production). Never commit real values.

DATABASE_URL=mysql://user:password@localhost:3306/agtci
# 32+ random characters; also keys the session encryption and form tokens.
AUTH_SECRET=
WHATSAPP_NUMBER=

# --- Sign-in through bkesari.com (client area) --------------------------------
# All three OIDC_* unset = public pages only, no client area.
# Register this site on the bkesari.com hub of the SAME tier:
#   npm run auth -- client:add --id agtci-dev --kind oidc --tier dev --feature AGTCI \
#     --redirect https://dev.agtci.com/auth/callback \
#     --post-logout https://dev.agtci.com/ \
#     --backchannel https://dev.agtci.com/auth/backchannel-logout
OIDC_ISSUER=https://dev.bkesari.com/auth
OIDC_CLIENT_ID=agtci-dev
OIDC_CLIENT_SECRET=
# This site's own origin; the redirect URI is <AGTCI_URL>/auth/callback.
AGTCI_URL=https://dev.agtci.com

# Tests only: a throwaway database the test suite may write to.
TEST_DATABASE_URL=
